#!/usr/bin/env python3

import os
import sys
import argparse

from lliurex.lliurexupcli import LliurexUpCli

def custom_print_help():
    help_text = (
        "Usage:\n"
        "  lliurex-upgrade [FLAGS...]\n\n"
        "Flags:\n"
        "  -h, --help        Show help\n"
        "  -s, --sai         Update the system without pinning and enable try to update without conection to lliurex.net\n"
        "  -u, --unattended  Update the system in unattended mode. Does not require confirmation to update the system\n"
    )
    print(help_text)

#def custom_print_help

def custom_error(message):
    print(f"Error: {message}\n", file=sys.stderr)
    custom_print_help()
    sys.exit(2)

#def custom_error

class HelpAction(argparse.Action):
    def __call__(self, parser, namespace, values, option_string=None):
        parser.print_help()
        sys.exit(0)

    #def __call__

#class HelpAction

def main():

	if os.geteuid() != 0:
		print("  [Lliurex-Up]: You need be root!")
		sys.exit(1)

	parser = argparse.ArgumentParser(add_help=False)
	parser.print_help = custom_print_help
	parser.error = custom_error

	parser.add_argument("-h", "--help", action=HelpAction, nargs=0)
	parser.add_argument("-s", "--sai", action="store_true", dest="sai")
	parser.add_argument("-u", "--unattended", action="store_true", dest="unattended")

	parser.add_argument("-r", "--repositories", action="store_true", dest="repositories", help=argparse.SUPPRESS)

	try:
		args = parser.parse_args()
	except argparse.ArgumentError:
		parser.print_help()
		sys.exit(1)

	mode = "sai" if args.sai else None

	extraArgs = {
		"mirror": False,
		"unattended_mirror": True,
		"unattendend_upgrade": args.unattended,
		"repositories": False
	}

	lliurexupcli = LliurexUpCli()
	sys.exit(lliurexupcli.updateAction(mode, extraArgs))

#def main

if __name__ == '__main__':
	main()